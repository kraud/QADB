# QADB — environment variables (server-only; never exposed to the client)

# Turso database URL — create with:  turso db create qadb
NUXT_TURSO_URL=libsql://your-database-here.turso.io

# Turso auth token — create with:   turso db tokens create qadb
TURSO_AUTH_TOKEN=

# Sealed session secret (>= 32 chars) — generate with:  openssl rand -base64 32
NUXT_SESSION_PASSWORD=

# OpenCode Go API key (REQUIRED for the "Format with AI" button). The endpoint
# calls `deepseek-v4-flash` on the OpenCode Go subscription plan (monthly token
# allowance; no Zen credits consumed). Either NUXT_OPENCODE_API_KEY or
# OPENCODE_API_KEY works.
OPENCODE_API_KEY=
