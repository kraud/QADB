# QADB — environment variables (server-only; never exposed to the client)

# Database URL. For local development run `pnpm db:local` in its own terminal and keep this value.
# A deployment sets its remote database URL in the host's settings instead.
NUXT_TURSO_URL=http://127.0.0.1:8080

# Database auth token. Leave empty for the local database. (NUXT_TURSO_TOKEN also works.)
TURSO_AUTH_TOKEN=

# Sealed session secret (>= 32 chars) — generate with:  openssl rand -base64 32
NUXT_SESSION_PASSWORD=

# Registration is closed unless this is "true". Open it only to create an account.
NUXT_PUBLIC_REGISTRATION_OPEN=false

# OpenCode Go API key, needed only for the "Format" button on answers. It is billed against the
# subscription's monthly allowance. Either NUXT_OPENCODE_API_KEY or OPENCODE_API_KEY works.
OPENCODE_API_KEY=
