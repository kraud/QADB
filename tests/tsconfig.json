{
  // The tests run in Node and import server, shared and app code, so they need Nuxt's server types.
  "extends": "../.nuxt/tsconfig.server.json",
  "compilerOptions": {
    "lib": ["esnext", "dom", "dom.iterable"]
  },
  "include": [
    "../.nuxt/types/nitro-nuxt.d.ts",
    "../.nuxt/types/nitro.d.ts",
    "../shared/**/*.d.ts",
    "./**/*",
    "../playwright.config.ts",
    "../vitest.config.ts"
  ]
}
